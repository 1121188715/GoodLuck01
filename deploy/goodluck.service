# GoodLuck 后端 systemd 服务
# 使用方法：sudo cp deploy/goodluck.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable goodluck
#          sudo systemctl start goodluck
# 注意：ExecStart 中的路径需与你的项目路径一致

[Unit]
Description=GoodLuck Backend API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/GoodLuck/backend
Environment="PATH=/var/www/GoodLuck/backend/.venv/bin"
Environment="CORS_ORIGINS=*"
ExecStart=/var/www/GoodLuck/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
